# Bosselli Gestión — variables de entorno
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas el .env real a git (contiene contraseñas).

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-cambiar-en-produccion-bosselli-1973
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
OCR_ACTIVO=True

# Email (Gmail con App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tuemail@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail
DEFAULT_FROM_EMAIL=Bosselli <tuemail@gmail.com>

# Base de datos (por defecto SQLite)
# DATABASE_URL=postgres://user:pass@host:5432/bosselli